{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ryolune",
  "version": "0.11.1",
  "identifier": "org.ryolune.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ryolune",
        "width": 1600,
        "height": 1000,
        "minWidth": 1120,
        "minHeight": 760,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#222221",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' blob: data:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src ipc: http://ipc.localhost 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["assets/ryolune.icns", "icons/icon.png", "icons/icon.ico"]
  }
}
