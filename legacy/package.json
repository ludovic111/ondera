{
  "name": "ondera",
  "private": true,
  "version": "0.0.1",
  "description": "Open-source cross-platform DAW, driveable by humans and agents",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ondera/app dev",
    "build": "pnpm --filter @ondera/app build",
    "typecheck": "pnpm -r typecheck",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "check": "pnpm typecheck && pnpm lint:tokens",
    "site:tokens": "node ../scripts/gen-site-tokens.mjs",
    "site:dev": "npm --prefix ../site start"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
